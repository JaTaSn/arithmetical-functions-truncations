# LaTeX build products -- arXiv builds its own, and a stale PDF is how you
# submit the wrong version
*.aux
*.log
*.out
*.toc
*.synctex.gz
arxiv/**/*.pdf

# ...but a figure is source, not a build product.
!arxiv/**/Cnv-profile.pdf
!arxiv/**/S2-ratio.pdf

# NOTE: the four extension rules above are unanchored, so they apply repo-wide, not just to
# LaTeX directories.  A run output named foo.log or foo.out anywhere in this repository is
# silently dropped by `git add` -- which is why everything in runs/ is .txt.  If you ever add
# a run output with another extension, check `git check-ignore -v <path>` first.

# AUCTeX per-directory parse cache -- editor state, not source.
.auctex-auto/

# The arXiv upload bundle is reproducible from the tracked sources -- see the
# regeneration command in arxiv/dirichlet-revisited/SUBMISSION.txt -- so it is not
# tracked. Use a git tag to record which commit was actually submitted.
*-arxiv-*.tar.gz
