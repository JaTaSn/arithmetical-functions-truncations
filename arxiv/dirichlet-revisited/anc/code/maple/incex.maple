v := proc(n)
local i,A,B;
if (n = 1) then RETURN(x[1]^2); 
elif (n = 2) then RETURN((x[1]-1)*(x[1]+x[2]^4)*x[2]^2); fi; 
A := 1; B := x[n]^2;
for i from 1 to n-1 do A := A*(x[i] - 1); od;
for i from 1 to n-2 do B := B*x[i]; od; 
RETURN(A*B*(x[n-1] + x[n]^4));
end;
